{
  // Use the same Worker name you already deploy (your address starts with "sheirleyshop.").
  "name": "sheirleyshop",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    // The folder that holds index.html, privacy.html, etc.
    "directory": "./public",
    "binding": "ASSETS",
    // Without this, Cloudflare serves the files directly and the Worker never sees the page request.
    "run_worker_first": true
  },
  // Limits for the AI assistant at /api/chat (per visitor address). Cloudflare applies each one per location, and
  // worker.js also keeps its own backstop limit, so the assistant is never left unprotected.
  // No AI key is here: the Groq key stays in Cloudflare as the secret GROQ_API_KEY.
  // Cloudflare's own AI (free allowance, no key). The Worker uses it first and Groq as the backup.
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHAT_BURST_LIMITER",  "namespace_id": "7301", "simple": { "limit": 3,   "period": 10 } },
    { "name": "CHAT_MINUTE_LIMITER", "namespace_id": "7302", "simple": { "limit": 12,  "period": 60 } },
    { "name": "CHAT_GLOBAL_LIMITER", "namespace_id": "7303", "simple": { "limit": 150, "period": 60 } }
  ]
}
